<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contrôleur de Lumières Twinkly</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            text-align: center;
        }

        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #555;
            font-weight: 600;
        }

        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: #667eea;
        }

        .button-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-large {
            width: 100%;
            padding: 16px;
            font-size: 18px;
        }

        .color-picker-group {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        input[type="color"] {
            width: 60px;
            height: 50px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .status {
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            display: none;
        }

        .status.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status.info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .movies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 10px;
            max-height: 300px;
            overflow-y: auto;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .movies-grid:empty {
            display: none;
        }

        .movie-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }

        .movie-card:hover {
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(102, 126, 234, 0.2);
        }

        .movie-card.selected {
            border-color: #667eea;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .movie-card .movie-id {
            font-size: 12px;
            color: #999;
            margin-top: 5px;
        }

        .movie-card.selected .movie-id {
            color: rgba(255, 255, 255, 0.8);
        }

        .movie-name {
            font-weight: 600;
            font-size: 14px;
            word-break: break-word;
        }

        .queue-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .queue-section h3 {
            color: #333;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .current-display {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 15px;
            text-align: center;
        }

        .current-display h4 {
            margin-bottom: 10px;
            font-size: 18px;
        }

        .current-display .time-remaining {
            font-size: 32px;
            font-weight: bold;
            margin: 10px 0;
        }

        .current-display .user-info {
            font-size: 16px;
            opacity: 0.9;
        }

        .queue-list {
            list-style: none;
        }

        .queue-item {
            background: white;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid #667eea;
        }

        .queue-item .position {
            background: #667eea;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

        .queue-item .info {
            flex: 1;
            margin: 0 15px;
        }

        .queue-item .nickname {
            font-weight: 600;
            color: #333;
        }

        .queue-item .choice {
            font-size: 12px;
            color: #666;
            margin-top: 3px;
        }

        .queue-item .color-preview {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid #e0e0e0;
        }

        .empty-queue {
            text-align: center;
            color: #999;
            padding: 20px;
            font-style: italic;
        }

        .control-type-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
        }

        .control-type-btn {
            padding: 15px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
            font-weight: 600;
        }

        .control-type-btn:hover {
            border-color: #667eea;
        }

        .control-type-btn.active {
            border-color: #667eea;
            background: #667eea;
            color: white;
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>File d'Attente des Lumières Twinkly</h1>
        <p class="subtitle">Contrôlez les lumières à tour de rôle!</p>

        <!-- Current Display & Queue Status -->
        <div class="queue-section">
            <h3>⏱️ En Cours</h3>
            <div class="current-display" id="currentDisplay">
                <div class="user-info">En attente du premier utilisateur...</div>
            </div>
            
            <h3>� File d'Attente (<span id="queueCount">0</span>)</h3>
            <ul class="queue-list" id="queueList">
                <li class="empty-queue">Personne dans la file</li>
            </ul>
        </div>

        <!-- Join Queue Form -->
        <div class="form-group">
            <label for="nickname">Votre Surnom (Optionnel)</label>
            <input type="text" id="nickname" placeholder="ex: Père Noël, Anonyme, etc." maxlength="20">
        </div>

        <div class="form-group">
            <label>Choisissez le Type de Contrôle</label>
            <div class="control-type-selector">
                <div class="control-type-btn active" onclick="selectControlType('color')" id="colorTypeBtn">
                    � Couleur Unie
                </div>
                <div class="control-type-btn" onclick="selectControlType('effect')" id="effectTypeBtn">
                    ✨ Effet
                </div>
            </div>
        </div>

        <!-- Color Selection -->
        <div class="form-group" id="colorSection">
            <label>Choisissez une Couleur</label>
            <div class="color-picker-group">
                <input type="color" id="colorPicker" value="#ff0000">
                <span id="colorLabel" style="flex: 1; font-weight: 600;">Rouge</span>
            </div>
        </div>

        <!-- Effect Selection -->
        <div class="form-group hidden" id="effectSection">
            <label>Choisissez un Effet</label>
            <button class="btn-primary" onclick="loadMovies()" style="width: 100%; margin-bottom: 10px;">Charger les Effets</button>
            <div class="movies-grid" id="moviesGrid"></div>
        </div>

        <button class="btn-primary btn-large" onclick="joinQueue()">
            � Rejoindre la File (2 min)
        </button>

        <div id="status" class="status"></div>
    </div>

    <script>
        const API_BASE = 'https://home.nassab.ca/api';
        const TWINKLY_IP = '10.10.20.15';
        let currentMovies = [];
        let selectedMovieId = null;
        let controlType = 'color'; // 'color' or 'effect'
        let queueUpdateInterval;

        function showStatus(message, type) {
            const status = document.getElementById('status');
            status.textContent = message;
            status.className = `status ${type}`;
            status.style.display = 'block';
            setTimeout(() => {
                status.style.display = 'none';
            }, 5000);
        }

        function selectControlType(type) {
            controlType = type;
            
            // Update button states
            document.getElementById('colorTypeBtn').classList.toggle('active', type === 'color');
            document.getElementById('effectTypeBtn').classList.toggle('active', type === 'effect');
            
            // Show/hide sections
            document.getElementById('colorSection').classList.toggle('hidden', type !== 'color');
            document.getElementById('effectSection').classList.toggle('hidden', type !== 'effect');
        }

        // Update color label when color changes
        document.getElementById('colorPicker').addEventListener('input', (e) => {
            const color = e.target.value;
            const colorNames = {
                '#ff0000': 'Rouge',
                '#00ff00': 'Vert',
                '#0000ff': 'Bleu',
                '#ffff00': 'Jaune',
                '#ff00ff': 'Magenta',
                '#00ffff': 'Cyan',
                '#ffffff': 'Blanc',
                '#000000': 'Noir',
                '#ffa500': 'Orange',
                '#800080': 'Violet'
            };
            document.getElementById('colorLabel').textContent = colorNames[color.toLowerCase()] || color.toUpperCase();
        });

        async function loadMovies() {
            showStatus('Chargement des effets disponibles...', 'info');
            
            try {
                const response = await fetch(`${API_BASE}/movies`);
                if (!response.ok) {
                    throw new Error(`Erreur HTTP! statut: ${response.status}`);
                }
                const data = await response.json();
                currentMovies = data.movies || [];
                
                if (currentMovies.length === 0) {
                    showStatus('Aucun effet trouvé sur l\'appareil', 'error');
                    return;
                }
                
                displayMovies();
                showStatus(`${currentMovies.length} effets chargés!`, 'success');
            } catch (error) {
                showStatus('Erreur lors du chargement des effets: ' + error.message, 'error');
            }
        }

        function displayMovies() {
            const grid = document.getElementById('moviesGrid');
            grid.innerHTML = '';
            
            currentMovies.forEach((movie, index) => {
                const card = document.createElement('div');
                card.className = 'movie-card';
                if (movie.id === selectedMovieId) {
                    card.className += ' selected';
                }
                
                card.innerHTML = `
                    <div class="movie-name">${movie.name || `Effect ${index + 1}`}</div>
                    <div class="movie-id">ID: ${movie.id}</div>
                `;
                
                card.onclick = () => selectMovie(movie.id);
                grid.appendChild(card);
            });
        }

        function selectMovie(movieId) {
            selectedMovieId = movieId;
            displayMovies();
        }

        async function joinQueue() {
            const nickname = document.getElementById('nickname').value.trim() || 'Anonyme';
            
            if (controlType === 'effect' && !selectedMovieId) {
                showStatus('Veuillez d\'abord sélectionner un effet!', 'error');
                return;
            }
            
            showStatus('Rejoindre la file...', 'info');
            
            try {
                const payload = {
                    nickname: nickname,
                    type: controlType
                };
                
                if (controlType === 'color') {
                    const color = document.getElementById('colorPicker').value;
                    payload.color = color;
                } else {
                    payload.movieId = selectedMovieId;
                }
                
                const response = await fetch(`${API_BASE}/queue/join`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || `Erreur HTTP! statut: ${response.status}`);
                }
                
                const data = await response.json();
                showStatus(`Vous êtes dans la file! Position: ${data.position}`, 'success');
                updateQueue();
            } catch (error) {
                showStatus('Erreur: ' + error.message, 'error');
            }
        }

        async function updateQueue() {
            try {
                const response = await fetch(`${API_BASE}/queue/status`);
                if (!response.ok) return;
                
                const data = await response.json();
                
                // Update current display
                const currentDisplay = document.getElementById('currentDisplay');
                if (data.current) {
                    const timeLeft = Math.max(0, Math.ceil(data.current.timeRemaining / 1000));
                    const minutes = Math.floor(timeLeft / 60);
                    const seconds = timeLeft % 60;
                    
                    let choiceText = '';
                    if (data.current.type === 'color') {
                        choiceText = `Couleur: ${data.current.color}`;
                    } else {
                        const movie = currentMovies.find(m => m.id === data.current.movieId);
                        choiceText = `Effet: ${movie ? movie.name : 'Effet ' + data.current.movieId}`;
                    }
                    
                    currentDisplay.innerHTML = `
                        <h4>${data.current.nickname}</h4>
                        <div class="time-remaining">${minutes}:${seconds.toString().padStart(2, '0')}</div>
                        <div class="user-info">${choiceText}</div>
                    `;
                } else {
                    currentDisplay.innerHTML = '<div class="user-info">En attente du premier utilisateur...</div>';
                }
                
                // Update queue list
                const queueList = document.getElementById('queueList');
                const queueCount = document.getElementById('queueCount');
                queueCount.textContent = data.queue.length;
                
                if (data.queue.length === 0) {
                    queueList.innerHTML = '<li class="empty-queue">Personne dans la file</li>';
                } else {
                    queueList.innerHTML = data.queue.map((item, index) => {
                        let choiceText = '';
                        let colorPreview = '';
                        
                        if (item.type === 'color') {
                            choiceText = `Couleur Unie`;
                            colorPreview = `<div class="color-preview" style="background-color: ${item.color}"></div>`;
                        } else {
                            const movie = currentMovies.find(m => m.id === item.movieId);
                            choiceText = movie ? movie.name : `Effet ${item.movieId}`;
                            colorPreview = '<div class="color-preview" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)"></div>';
                        }
                        
                        return `
                            <li class="queue-item">
                                <div class="position">${index + 1}</div>
                                <div class="info">
                                    <div class="nickname">${item.nickname}</div>
                                    <div class="choice">${choiceText}</div>
                                </div>
                                ${colorPreview}
                            </li>
                        `;
                    }).join('');
                }
            } catch (error) {
                console.error('Erreur lors de la mise à jour de la file:', error);
            }
        }

        // Update queue every 1 second
        queueUpdateInterval = setInterval(updateQueue, 1000);
        
        // Initial queue load
        updateQueue();
    </script>
</body>
</html>
